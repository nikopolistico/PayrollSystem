# Copy to .env.local (never commit .env.local).
# Neon console → your project → Connect → copy the connection string (use ?sslmode=verify-full)
DATABASE_URL=postgresql://user:password@ep-xxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full
# Any long random string, e.g. output of:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
